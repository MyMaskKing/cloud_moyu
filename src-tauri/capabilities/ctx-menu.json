{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "ctx-menu",
  "description": "右键菜单独立窗口:允许 emit 事件和关闭自身",
  "windows": ["ctx-menu"],
  "webviews": ["ctx-menu"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-emit",
    "core:window:allow-close",
    "core:webview:allow-webview-close"
  ]
}
